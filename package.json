{
  "name": "sportspot",
  "version": "1.0.0",
  "description": "Urban sports discovery app for Bangalore",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --parallel -r dev",
    "dev:api": "pnpm --filter api dev",
    "dev:mobile": "pnpm --filter mobile start",
    "build": "pnpm --filter=./apps/api build && pnpm --filter=./apps/mobile build",
    "type-check": "pnpm -r type-check"
  }
}
